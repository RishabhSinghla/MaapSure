# Copy to the protected deployment environment; never commit real secrets.
PORT=4173
NODE_ENV=production
MAAPSURE_DEMO_MODE=false

# Generate a private random value of at least 32 characters in the secret manager.
JWT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_FROM_YOUR_SECRET_MANAGER

# Must be the exact trusted HTTPS origin. The server rejects Host-header fallbacks.
PUBLIC_BASE_URL=https://maapsure.example.gov.in/

# Mount a protected persistent directory containing a controlled user registry.
MAAPSURE_DATA_DIR=/var/lib/maapsure

# Synthetic fixtures are rejected in production unless this exceptional demo-only
# switch is deliberately enabled. Leave it false for any laboratory deployment.
ALLOW_SYNTHETIC_DEMO=false
