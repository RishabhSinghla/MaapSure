{
  "name": "maapsure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Digital OIML R-76 test reporting and verification for non-automatic weighing instruments.",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"PORT=4000 node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/integrationFlow.mjs",
    "check": "npm run test && npm run test:integration && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
